{
  "name": "credit-os-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "5.4.1",
    "jsdom": "27.4.0",
    "knip": "6.41.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.6",
    "vitest": "4.1.11"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "lint": "eslint --max-warnings=0 .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "unused": "knip",
    "duplication": "node scripts/duplication.mjs",
    "build": "tsc --noEmit && vite build",
    "test:file": "vite build && node scripts/open-from-disk.mjs",
    "gates": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run audit && npm run unused && npm run duplication && npm run build && npm run test:file"
  }
}
