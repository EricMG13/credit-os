    "history.subtitle": {"placeholders": ["count", "month_year"], "count": "count", "count_min": 2, "text": "Report history: {count} runs since {month_year}"},
    "history.subtitle_one": {"placeholders": [], "text": "Report history: 1 run"},
    "history.subtitle_unfinished": {"placeholders": ["count"], "count": "count", "count_min": 1, "one": "{count} run, not finished", "other": "{count} runs, not finished"},
    "history.empty": {"placeholders": [], "text": "No run on this issuer has a report yet. Start a new run to write the first report."},
    "history.text.finished": {"placeholders": ["delivered", "planned"], "count": "planned", "count_min": 1, "one": "{delivered} of {planned} module delivered.", "other": "{delivered} of {planned} modules delivered."},
    "history.text.capped": {"placeholders": ["delivered", "planned"], "count": "planned", "count_min": 1, "one": "The run stopped at its cost cap after {delivered} of {planned} module.", "other": "The run stopped at its cost cap after {delivered} of {planned} modules."},
    "history.text.interrupted": {"placeholders": ["delivered", "planned"], "count": "planned", "count_min": 1, "one": "Interrupted after {delivered} of {planned} module.", "other": "Interrupted after {delivered} of {planned} modules."},
    "history.text.failed": {"placeholders": [], "text": "The run failed before it finished."},
    "history.text.rejected": {"placeholders": [], "text": "The run did not start."},
    "history.text.running": {"placeholders": [], "text": "In progress."},
    "history.text.queued": {"placeholders": [], "text": "Not started yet."},
    "changes.none.title": {"placeholders": [], "text": "No earlier run to compare"},
    "changes.none.text": {"placeholders": ["issuer_name"], "text": "This is the first report on {issuer_name}. What changed will appear here after the next run."},
    "changes.pending.title": {"placeholders": [], "text": "Comparison not yet run"},
    "changes.pending.text": {"placeholders": ["issuer_name"], "text": "An earlier report exists on {issuer_name}; the comparison with it has not been run."},
    "overview.metrics_label": {"placeholders": [], "text": "Headline figures"},
    "overview.modules_summary": {"placeholders": ["delivered", "total"], "text": "{delivered} of {total} delivered"},
    "overview.gaps_link": {"placeholders": ["count"], "count": "count", "count_min": 1, "one": "See the {count} gap in Evidence", "other": "See the {count} gaps in Evidence"}
  }
